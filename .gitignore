# Зависимости
node_modules/

# Переменные окружения и секреты
.env
.env.local
.env.*.local

# Артефакты сборки
dist/
build/
out/
.next/

# Логи и временные файлы
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE и редакторы
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Тесты и покрытие
coverage/
.nyc_output/

# Локальные конфиги
*.local

# Бэкапы — содержимое не пушим, остаётся только пустая папка
backups/**
!backups/.gitkeep

# Загруженные изображения — только структура папок, без файлов
public/img/uploads/**
!public/img/uploads/**/
!public/img/uploads/**/.gitkeep
